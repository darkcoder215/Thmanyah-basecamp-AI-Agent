# ───── Basecamp OAuth ─────
# Create an integration at https://launchpad.37signals.com/integrations
BASECAMP_CLIENT_ID=
BASECAMP_CLIENT_SECRET=
BASECAMP_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Required User-Agent — Basecamp rejects requests without one
BASECAMP_USER_AGENT="Thmanyah Basecamp Agent (contact@thmanyah.com)"

# ───── Supabase (server-only) ─────
# Use the service role key — never exposed to the browser
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ───── Anthropic (server-only) ─────
ANTHROPIC_API_KEY=

# ───── Session + token encryption ─────
# 32-byte URL-safe secret (openssl rand -base64 32)
SESSION_SECRET=
# 32-byte AES key used to encrypt Basecamp tokens before they hit Supabase
TOKEN_ENCRYPTION_KEY=

# ───── App base URL (for absolute links in OAuth + callbacks) ─────
APP_BASE_URL=http://localhost:3000
